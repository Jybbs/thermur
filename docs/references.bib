    journal  = {Proceedings of the National Academy of Sciences},
    year     = {2014},
    volume   = {111},
    number   = {29},
    pages    = {10422--10426},
    doi      = {10.1073/pnas.1402202111},
    priority = {prio3},
    annote   = {Pearce and colleagues argue that local interactions alone cannot set the density of a large flock, and propose a model in which each bird steers toward the projection of the flock it sees against the sky, combined with alignment to its nearest neighbors and noise, each weighted at every step of a bird flying its own size a step. The model's flocks hold together and settle at marginal opacity, the densest a flock can be while a bird inside still sees out in many directions, which the authors compare with experimental data on starling flocks. The model is two weights and a noise on a discrete step, with no measured interaction behind its projection. Each step replaces a bird's heading in full with the weighted sum, and Thermur takes that step, read as the time a starling takes to fly its wingspan, as the time over which the default coupling turns a heading toward its seven neighbors, so the study shapes the composite little, as the source of one value.}
}

@article{poel2022,
    author   = {Poel, Winnie and Daniels, Bryan C. and Sosna, Matthew M. G. and Twomey, Colin R. and Leblanc, Simon P. and Couzin, Iain D. and Romanczuk, Pawel},
    title    = {Subcritical escape waves in schooling fish},
    journal  = {Science Advances},
    year     = {2022},
    volume   = {8},
    number   = {25},
    pages    = {eabm6385},
    doi      = {10.1126/sciadv.abm6385},
    priority = {prio2},
    annote   = {Poel and colleagues treat the startle cascades of schooling golden shiners as a branching process over the visual network between fish and find the measured schools subcritical, their branching ratio below one, moving closer to one as the perceived risk rises. The study measures fish rather than birds, and it bears on the branching ratio of one Thermur's zig copies at, so it shapes the noise slot moderately.}
}

@article{procaccini2011,
    author   = {Procaccini, Andrea and Orlandi, Alberto and Cavagna, Andrea and Giardina, Irene and Zoratto, Francesca and Santucci, Daniela and Chiarotti, Flavia and Hemelrijk, Charlotte K. and Alleva, Enrico and Parisi, Giorgio and Carere, Claudio},
    title    = {Propagating waves in starling, \textit{Sturnus vulgaris}, flocks under predation},
    journal  = {Animal Behaviour},
    year     = {2011},
    volume   = {82},
    number   = {4},
    pages    = {759--765},
    doi      = {10.1016/j.anbehav.2011.07.006},
    priority = {prio2},
    annote   = {Procaccini and colleagues filmed falcons hunting starling flocks over two roosts in Rome, of about 20,000 and 60,000 birds, in high definition at 30 frames a second across two winters, recording more than 100 waves, which 210 of 329 hunting sequences triggered. Each wave travels away from the falcon, at 3.66 to 25.24 m/s with a mean of 13.04 m/s across 15 pulses, speeds measured against the flock's center and read as lower limits that may run 40 percent higher, and a hunt succeeded 0.14 of the time where waves arose against 0.30 where none did. The footage is two-dimensional, so the density the authors read the waves as goes unmeasured. The direction of travel, away from the threat, is the pattern Thermur's escape is checked for against a fire, so the study shapes the escape slot moderately, while the mechanism behind the band comes from Hemelrijk et al. 2015.}
}

@article{schilling2021,
    author   = {Schilling, Fabian and Schiano, Fabrizio and Floreano, Dario},
    title    = {Vision-Based Drone Flocking in Outdoor Environments},
    journal  = {IEEE Robotics and Automation Letters},
    year     = {2021},
    volume   = {6},
    number   = {2},
    pages    = {2954--2961},
    doi      = {10.1109/LRA.2021.3062298},
    priority = {prio2},
    annote   = {Schilling and colleagues flew three quadcopters outdoors with no communication and no visual markers, each detecting its neighbors with a convolutional network on omnidirectional cameras and tracking their relative positions and velocities for a flocking controller, and the drones navigated safely despite background clutter and difficult light. The entry rests on the study's abstract. Thermur's cohesion slot borrows the spring toward the neighbors' centroid such a controller flies as one candidate, so the study shapes the composite only where that candidate is favored.}
}

@article{storms2019,
    author   = {Storms, Rolf F. and Carere, Claudio and Zoratto, Francesca and Hemelrijk, Charlotte K.},
    title    = {Complex patterns of collective escape in starling flocks under predation},
    journal  = {Behavioral Ecology and Sociobiology},
    year     = {2019},
    volume   = {73},
    number   = {1},
    pages    = {10},
    doi      = {10.1007/s00265-018-2609-0},
    priority = {prio1},
    annote   = {Storms and colleagues scored 795 collective events frame by frame under blinded methods in 67 of 182 sequences of falcons hunting starlings over Rome, classifying blackening (36.4 percent), waves (25.8), splits (15.8), merges (8.9), flash expansions (8.1), cordons (4.4), and vacuoles (0.6). An agitation wave lasts 3.5 s with a standard error of 0.23 and carries 2.88 pulses with a standard error of 0.19, over 133 pulses, about 0.86 s apart, and the pattern depends on the attack, flash expansion following fast attacks from above, waves most likely around attacks of medium speed, and blackening independent of the attack. A viewing angle can confuse blackening with waves, and without tracking individual birds the mechanisms stay open. The wave's duration and its pulse count are the norm Thermur's escape slot answers to, and the dependence on the attack is why the fire's approach speed is swept, so the study shapes the composite strongly, although flash expansion and the rolling behind a wave have no clear analog for a drone facing a slow plume.}
}

@article{torney2018,
    author   = {Torney, Colin J. and Lamont, Myles and Debell, Leon and Angohiatok, Ryan J. and Leclerc, Lisa-Marie and Berdahl, Andrew M.},
    title    = {Inferring the rules of social interaction in migrating caribou},
    journal  = {Philosophical Transactions of the Royal Society B: Biological Sciences},
    year     = {2018},
    volume   = {373},
    number   = {1746},
    pages    = {20170385},
    doi      = {10.1098/rstb.2017.0385},
    priority = {prio2},
    annote   = {Torney and colleagues filmed migrating caribou from unmanned aircraft and inferred their interaction rules through a Bayesian analysis of the trajectories, finding that caribou attract one another and copy their neighbors' directional choices without a clearly defined metric or topological range, and mapping how strongly each near neighbor influences a movement. The entry rests on the study's abstract. Thermur's trials rank candidate composites by the likelihood of a flight under each, as this study ranks its models, so it shapes how candidates are told apart rather than the composite itself.}
}

@article{turner2009,
    author   = {Turner, John and Anderson, Phil and Lachlan-Cope, Tom and Colwell, Steve and Phillips, Tony and Kirchgaessner, Am{\'e}lie and Marshall, Gareth J. and King, John C. and Bracegirdle, Tom and Vaughan, David G. and Lagun, Victor and Orr, Andrew},
