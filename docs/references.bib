@article{attanasi2014,
    author   = {Attanasi, Alessandro and Cavagna, Andrea and Del Castello, Lorenzo and Giardina, Irene and Grigera, Tomas S. and Jelić, Asja and Melillo, Stefania and Parisi, Leonardo and Pohl, Oliver and Shen, Edward and Viale, Massimiliano},
    title    = {Information transfer and behavioural inertia in starling flocks},
    journal  = {Nature Physics},
    year     = {2014},
    volume   = {10},
    number   = {9},
    pages    = {691--696},
    doi      = {10.1038/nphys3035},
    priority = {prio1},
    annote   = {Attanasi and colleagues filmed 12 starling flocks turning over the Piazza dei Cinquecento in Rome with three cameras at 170 frames a second, reconstructing 50 to 595 birds per flock in three dimensions through events of 2 to 13 seconds while the flocks flew at 7 to 12 m/s. A turn starts with a few birds and crosses the flock linearly in time with negligible attenuation, at speeds the published text puts at 20 to 40 m/s, whereas the arXiv preprint of the study gives speeds half as large. The speed grows as one over the square root of one minus the polarization, a dispersion an overdamped alignment rule cannot give, since under such a rule a turn spreads by diffusion and fades, and it follows from a model whose birds carry a conserved spin with behavioral inertia. The authors treat constant speed as an effective assumption and read the linear regime only before a turn reaches the border. The study sets the norm a turn in Thermur's flock is held to and is the measured reason its heading slot carries inertia, so it shapes the composite strongly, although a drone flock meets it only in dimensionless form, as the wave's speed over the cruise speed.}
}

@article{ballerini2008a,
    author   = {Ballerini, Michele and Cabibbo, Nicola and Candelier, Raphael and Cavagna, Andrea and Cisbani, Evaristo and Giardina, Irene and Lecomte, Vivien and Orlandi, Alberto and Parisi, Giorgio and Procaccini, Andrea and Viale, Massimiliano and Zdravkovic, Vladimir},
    title    = {Interaction ruling animal collective behavior depends on topological rather than metric distance: Evidence from a field study},
    journal  = {Proceedings of the National Academy of Sciences},
    year     = {2008},
    volume   = {105},
    number   = {4},
    pages    = {1232--1237},
    doi      = {10.1073/pnas.0711437105},
    priority = {prio1},
    annote   = {Ballerini and colleagues reconstructed in three dimensions 10 flocks of more than 400 European starlings each, photographed in stereo over the Termini roost in Rome at dusk in the winter of 2005 to 2006. Reading how anisotropic the position of each bird's nth nearest neighbor is, they find that a bird interacts with a fixed number of neighbors, 6.5 with a standard error of 0.9, whatever the flock's density, whereas the metric range of the interaction grows with the spacing between birds. In two-dimensional simulations of a predator's attack, a topological rule keeps a flock more cohesive than a metric one. The count comes from the flock's structure rather than from a fitted dynamics and rests on 10 flocks of one species at one roost, and the authors expect a metric limit in very sparse flocks. Each drone in Thermur reads its seven nearest neighbors on this evidence and the calibration holds that count fixed, so the study shapes the composite strongly, while a drone's radio range supplies the metric limit the authors anticipate.}
}

@article{ballerini2008b,
    author   = {Ballerini, Michele and Cabibbo, Nicola and Candelier, Raphael and Cavagna, Andrea and Cisbani, Evaristo and Giardina, Irene and Orlandi, Alberto and Parisi, Giorgio and Procaccini, Andrea and Viale, Massimiliano and Zdravkovic, Vladimir},
    title    = {Empirical investigation of starling flocks: a benchmark study in collective animal behaviour},
    journal  = {Animal Behaviour},
    year     = {2008},
    volume   = {76},
    number   = {1},
    pages    = {201--215},
    doi      = {10.1016/j.anbehav.2008.02.004},
    priority = {prio1},
    annote   = {Ballerini and colleagues set out the benchmark of the same campaign over the Termini roost in Rome, 10 flocks of 448 to 2,631 starlings reconstructed in three dimensions, with densities of 0.04 to 0.8 birds per cubic meter and nearest-neighbor distances of 0.68 to 1.51 m. Every flock is thin, its axes in the ratio 1 : 2.8 : 5.6 with 95 percent confidence intervals of 0.4 and 1.0 on the two ratios, its thinnest axis close to vertical, and it flies horizontally, its center of mass moving at 6.9 to 15.2 m/s. Every flock is denser at its border than at its center, and birds keep at least about 0.38 m apart, close to a starling's wingspan. The authors note the flock's orientation may differ under attack or at higher altitude. The study supplies the shape, the border-to-center density, and the speed range Thermur measures its flock against and builds its flight envelope around, so it shapes the composite strongly through those norms, while a drone's spacing departs from a starling's and leaves each comparison in dimensionless form.}
}

@article{berdahl2013,
    author   = {Berdahl, Andrew and Torney, Colin J. and Ioannou, Christos C. and Faria, Jolyon J. and Couzin, Iain D.},
    title    = {Emergent Sensing of Complex Environments by Mobile Animal Groups},
    journal  = {Science},
    year     = {2013},
    volume   = {339},
    number   = {6119},
    pages    = {574--576},
    doi      = {10.1126/science.1225883},
    priority = {prio1},
    annote   = {Berdahl and colleagues tracked groups of 1 to 256 juvenile golden shiners, \textit{Notemigonus crysoleucas}, in a 213 by 122 cm tank under a moving, noisy patch of dark projected onto it, which the fish seek. The darkness a group's fish sit in, averaged over time, grows with the group's size at every level of noise, while a single fish barely responds. Each fish slows in the dark, and its acceleration follows its neighbors within about 34 cm far more than the light, so the group turns toward its slower, darker side and gathers there, and agents that adjust their speed alone reproduce the result, the group's width against the scale of the field deciding how well it tracks the field. Fish in a tank sit far from drones over a fire, yet the mechanism carries over whole, so the study shapes Thermur's thermal response slot strongly, each drone modulating its speed and heading by the excess temperature at its own position while the gradient the flock follows emerges from neighbors reading different values.}
}

@article{berman2021,
    author   = {Berman, Simon A. and Buggeln, John and Brantley, David A. and Mitchell, Kevin A. and Solomon, Thomas H.},
    title    = {Transport barriers to self-propelled particles in fluid flows},
    journal  = {Physical Review Fluids},
    year     = {2021},
    volume   = {6},
    number   = {1},
    pages    = {L012501},
    doi      = {10.1103/PhysRevFluids.6.L012501},
    priority = {prio3},
    annote   = {Berman and colleagues model a self-propelled particle in a two-dimensional fluid flow, its position advancing at the local flow velocity plus its own swimming speed along its heading, and its heading turned by the flow's vorticity and strain. They find one-way barriers a swimmer crosses in one direction alone, sitting a distance of the swimming speed over the strain rate from a saddle of the flow, and confirm them with \textit{Bacillus subtilis} in two strains swimming at means of 16 and 25 micrometers per second through a hyperbolic flow in a 1 mm channel. Thermur takes the position half of the model alone, a drone's ground velocity being its airspeed plus the wind at its position, since an autopilot holds a drone's heading where the flow turns a swimmer's. The study sits far from a flock and shapes the composite little beyond that kinematic advection.}
}

@article{bialek2012,
    author   = {Bialek, William and Cavagna, Andrea and Giardina, Irene and Mora, Thierry and Silvestri, Edmondo and Viale, Massimiliano and Walczak, Aleksandra M.},
    title    = {Statistical mechanics for natural flocks of birds},
    journal  = {Proceedings of the National Academy of Sciences},
    year     = {2012},
    volume   = {109},
    number   = {13},
    pages    = {4786--4791},
    doi      = {10.1073/pnas.1118633109},
    priority = {prio2},
    annote   = {Bialek and colleagues fit a maximum-entropy model to the flight directions of 21 starling flocks of 122 to 4,268 birds over Rome, with polarizations of 0.844 to 0.995, finding the least structured model consistent with the measured correlations between neighbors. The model couples each bird with one constant strength to each of its nearest topological neighbors, and with no parameter left free it predicts the correlations across the whole flock, a correlation length growing with the flock's size among them. The fit gives about 21 neighbors, which the authors attribute to a static model counting neighbors that change during the measurement, and a calibration on simulated flocks brings it near 7.8, close to the count measured directly. The model reads directions alone, assumes a stationary state, and fixes the birds on the border. Thermur's coupling takes this form, one constant over a fixed count of topological neighbors, while the count of seven comes from the direct measurement, so the study shapes the coupling slot moderately, as its form and as evidence that so simple a coupling accounts for the measured correlations.}
}

@article{bialek2014,
    author   = {Bialek, William and Cavagna, Andrea and Giardina, Irene and Mora, Thierry and Pohl, Oliver and Silvestri, Edmondo and Viale, Massimiliano and Walczak, Aleksandra M.},
    title    = {Social interactions dominate speed control in poising natural flocks near criticality},
    journal  = {Proceedings of the National Academy of Sciences},
    year     = {2014},
    volume   = {111},
    number   = {20},
    pages    = {7212--7217},
    doi      = {10.1073/pnas.1324045111},
    priority = {prio2},
    annote   = {Bialek and colleagues extend the maximum-entropy model to full velocities, coupling each starling's speed to its neighbors' as well as its direction, beside a term holding every bird near one preferred speed. Fitted to flocks over Rome, the term holding a bird's own speed comes out about a thousandth of the coupling times the neighbor count, which places the flocks close to the critical point where that term vanishes and reproduces speed correlations whose length grows with the flock. A twofold change in the variance of the speed would break the agreement, and a simulation of 16,384 birds under the matching dynamics reproduces it. The authors argue for criticality and grant the term cannot be exactly zero. Thermur's speed channel takes the imitation of neighbors' speeds from this study and its results page sets the claim its own sweep supports against this argument, so the study shapes the composite moderately, the confinement around a cruise speed coming from Cavagna et al. 2022 instead.}
}

@article{carruitero2024,
    author   = {Carruitero, Sebastián and Costa Duran, Alejo and Pisegna, Giulia and Sturla, Mauricio B. and Grigera, Tomás S.},
    title    = {Inertial spin model of flocking with position-dependent forces},
    journal  = {Physical Review E},
    year     = {2024},
    volume   = {110},
    number   = {1},
    pages    = {014408},
    doi      = {10.1103/PhysRevE.110.014408},
    priority = {prio2},
    annote   = {Carruitero and colleagues add forces that depend on position, such as a confinement, to the inertial spin model, deriving that such a force enters only the spin's equation and acts through its component across the velocity, with the coupling times the inertia over the square of the friction setting how far the dynamics sit from the overdamped limit. They simulate one particle in a two-dimensional harmonic trap, finding a plateau in its mean squared displacement that scales as one over the trap's stiffness and grows with that ratio, and damped oscillations in its velocity correlation where the ratio is large. The paper tests no flock of many particles. The study sets how Thermur adds the position forces of its other slots, the cohesion, the contact, and the roost, to the heading's inertial spin, so it shapes the composite moderately, as the rule for combining slots rather than as a measured norm.}
}

@article{cavagna2010,
    author   = {Cavagna, Andrea and Cimarelli, Alessio and Giardina, Irene and Parisi, Giorgio and Santagati, Raffaele and Stefanini, Fabio and Viale, Massimiliano},
    title    = {Scale-free correlations in starling flocks},
    journal  = {Proceedings of the National Academy of Sciences},
    year     = {2010},
    volume   = {107},
    number   = {26},
    pages    = {11865--11870},
    doi      = {10.1073/pnas.1005766107},
    priority = {prio1},
    annote   = {Cavagna and colleagues reconstructed 24 starling flocks of 122 to 4,268 birds, 9.1 to 85.7 m across, over a roost in Rome at sunset across the winters of 2005 to 2007. The flocks are highly ordered, with a polarization of 0.96 and a standard deviation of 0.03, yet the fluctuations of both direction and speed around the flock's mean stay correlated across the whole flock, the correlation crossing zero at 0.35 of the flock's size for direction and 0.36 for speed. Correlated directions follow from order alone, whereas correlated speeds do not, since speed is a stiff mode, which makes the speed correlation the evidence the authors read as a flock poised near a critical point, while granting that very low noise is hard to tell apart from criticality. The polarization and the speed correlation's zero are norms Thermur holds its flock to, the first fitted and the second held out of the calibration, so the study shapes the composite strongly, and a constant-speed flight serves as the control showing that the speed correlation comes from the speed channel.}
}

@article{cavagna2015,
    author   = {Cavagna, Andrea and Del Castello, Lorenzo and Giardina, Irene and Grigera, Tomas S. and Jelic, Asja and Melillo, Stefania and Mora, Thierry and Parisi, Leonardo and Silvestri, Edmondo and Viale, Massimiliano and Walczak, Aleksandra M.},
    title    = {Flocking and Turning: a New Model for Self-organized Collective Motion},
    journal  = {Journal of Statistical Physics},
    year     = {2015},
    volume   = {158},
    number   = {3},
    pages    = {601--627},
    doi      = {10.1007/s10955-014-1119-3},
    priority = {prio1},
    annote   = {Cavagna and colleagues propose the inertial spin model, in which each bird's velocity turns at a fixed speed under a spin, the spin carrying the social force from its neighbors with an inertia and a friction, so that a turn can travel as a wave. Its dispersion relation gives a wave speed of the neighbor spacing times the square root of the coupling times the neighbor count over the inertia, and its overdamped limit recovers the continuous-time Vicsek model, under which a turn diffuses. A turn crosses a whole flock where the friction stays below the square root of the coupling times the neighbor count times the inertia, scaled by the neighbor spacing over the flock's size, and simulations of 512 particles with 6 neighbors each show a turn crossing the flock at low friction, fading at higher friction, and forming no collective turn at the highest. The analysis assumes a fixed network and the continuum limit. Thermur's heading slot runs this model, first in its overdamped limit and then with its inertia, holding that condition across the flock sizes flown, so the study shapes the composite strongly.}
}

@article{cavagna2022,
    author   = {Cavagna, Andrea and Culla, Antonio and Feng, Xiao and Giardina, Irene and Grigera, Tomas S. and Kion-Crosby, Willow and Melillo, Stefania and Pisegna, Giulia and Postiglione, Lorena and Villegas, Pablo},
    title    = {Marginal speed confinement resolves the conflict between correlation and control in collective behaviour},
    journal  = {Nature Communications},
    year     = {2022},
    volume   = {13},
    number   = {1},
    pages    = {2315},
    doi      = {10.1038/s41467-022-29883-4},
    priority = {prio1},
    annote   = {Cavagna and colleagues show that a control stiff enough to hold a group's speed suppresses the speed correlations starling flocks carry, and resolve the conflict with a marginal potential, the fourth power of the difference between a bird's squared speed and the squared reference speed, whose curvature at the reference speed is zero. Under it the speed correlation length grows with the flock's size while the typical speed stays near the reference speed in a large flock. Flocks of about 10 to 2,500 starlings tracked over a roost in Rome across campaigns from 2007 to 2020 show the speed correlation length growing linearly with size and a mean speed of about 12 m/s with no dependence on the number of birds. The dynamics vary each bird's speed directly, whereas the inertial spin model holds speed fixed, and the authors do not rule out other mechanisms. Thermur gives speed a channel of its own under this potential, confining each drone's airspeed around its cruise speed, so the study shapes the composite strongly, its norm of a speed correlation crossing zero at 0.36 of the flock's size pairing with Cavagna et al. 2010.}
}

@article{dorsogna2006,
    author   = {D'Orsogna, Maria R. and Chuang, Yao-Li and Bertozzi, Andrea L. and Chayes, Lincoln S.},
    title    = {Self-Propelled Particles with Soft-Core Interactions: Patterns, Stability, and Collapse},
    journal  = {Physical Review Letters},
    year     = {2006},
    volume   = {96},
    number   = {10},
    pages    = {104302},
    doi      = {10.1103/PhysRevLett.96.104302},
    priority = {prio2},
    annote   = {D'Orsogna and colleagues study self-propelled particles under a soft-core Morse potential, a short-range repulsion against a longer-range attraction each decaying exponentially, summed over every pair. With the ratio of the repulsion's strength to the attraction's and the ratio of their ranges as the two parameters, they map in two dimensions which swarms are H-stable, holding their spacing as they grow, and which are catastrophic, collapsing as particles join, the boundary falling where the strength ratio times the square of the range ratio equals one, and they find flocks, rings, vortices, and clumps across the regions. The simulations are deterministic and two-dimensional, with up to about 600 particles. Thermur's cohesion slot takes a generalized Morse potential over the topological neighbors alone, with parameters chosen outside the collapse region, so the study shapes the composite moderately, although its stability map is drawn for a sum over all pairs in two dimensions rather than over seven neighbors in three.}
}

@article{farkas2002,
    author   = {Farkas, Illés and Helbing, Dirk and Vicsek, Tamás},
    title    = {Mexican waves in an excitable medium},
    journal  = {Nature},
    year     = {2002},
    volume   = {419},
    number   = {6903},
    pages    = {131--132},
    doi      = {10.1038/419131a},
    priority = {prio3},
    annote   = {Farkas, Helbing, and Vicsek measure 14 Mexican waves on video of stadium crowds of more than 50,000, which travel at about 12 m/s, or 20 seats a second, across a band about 6 to 12 m wide, usually clockwise, started by a few dozen people at most. A model of an excitable medium reproduces them, each person activating once the weighted share of active people nearby passes a threshold drawn for each person, then passing through refractory states, and a wave starts only from a critical mass of initiators. Spectators in a stadium sit far from a flock in flight, so the study shapes Thermur's composite little, serving as a measured case of an excitable medium on a network of neighbors carrying a wave of fixed speed and width, the behavior the escape slot borrows for drones.}
}

@article{greenberg1978,
    author   = {Greenberg, J. M. and Hastings, S. P.},
    title    = {Spatial Patterns for Discrete Models of Diffusion in Excitable Media},
    journal  = {SIAM Journal on Applied Mathematics},
    year     = {1978},
    volume   = {34},
    number   = {3},
    pages    = {515--523},
    doi      = {10.1137/0134040},
    priority = {prio2},
    annote   = {Greenberg and Hastings study discrete models of an excitable medium, one with a globally stable resting state and a threshold past which a disturbance sets off a large but temporary response, and show that spatial inhomogeneities organize into patterns that repeat in time. No open copy of the paper is available, so this entry rests on its abstract alone. The models measure nothing of birds or drones, yet Thermur's escape slot runs the excitable structure the abstract describes on its neighbor graph, each drone resting, alarmed, firing a turn or a climb its neighbors copy, then refractory. The study therefore shapes that slot's structure moderately, while the norms the slot answers to come from starlings.}
}

@article{hemelrijk2015,
    author   = {Hemelrijk, Charlotte K. and van Zuidam, Lars and Hildenbrandt, Hanno},
    title    = {What underlies waves of agitation in starling flocks},
    journal  = {Behavioral Ecology and Sociobiology},
    year     = {2015},
    volume   = {69},
    number   = {5},
    pages    = {755--764},
    doi      = {10.1007/s00265-015-1891-3},
    priority = {prio2},
    annote   = {Hemelrijk, van Zuidam, and Hildenbrandt reproduce the agitation waves of starling flocks under attack in StarDisplay, with 2,000 birds by default and 500 to 8,000 tested. A wave appears only where a bird repeats a zig, a roll to one side and back, that it sees among its nearest neighbors, and it shows as a dark band through the change in the birds' orientation, whereas the same simulation drawn with spheres shows no band, so the wave carries no change of density. Copying from 2 to 7 neighbors at nearest-neighbor distances of 0.71 to 1.93 m reproduces the wave speeds of 3.66 to 25.24 m/s measured in the field. The results come from simulation alone and are offered as hypotheses for the field. A drone's change of heading shows no dark band, yet the relay of a maneuver copied among neighbors is the mechanism Thermur's escape slot runs, so the study shapes that slot moderately and rules out a density wave as its form.}
}

@article{higham2001,
    author   = {Higham, Desmond J.},
    title    = {An Algorithmic Introduction to Numerical Simulation of Stochastic Differential Equations},
    journal  = {SIAM Review},
    year     = {2001},
    volume   = {43},
    number   = {3},
    pages    = {525--546},
    doi      = {10.1137/S0036144500378302},
    priority = {prio3},
    annote   = {Higham introduces the numerical simulation of stochastic differential equations through short programs, drawing each Brownian increment as a standard normal sample scaled by the square root of the step, and advancing the Euler--Maruyama method by the drift times the step plus the diffusion times that increment. He shows Euler--Maruyama converging with strong order one half and weak order one, at measured slopes of 0.5384 and 0.9858, and the Milstein method with strong order one, for scalar equations under conditions on the drift and diffusion the paper leaves unstated. The paper concerns numerical method alone and measures nothing of flocks, so it shapes Thermur's composite little, grounding the square-root scaling of the noise each flight draws and the halved step its convergence test runs.}
}

@article{hildenbrandt2010,
    author   = {Hildenbrandt, Hanno and Carere, Claudio and Hemelrijk, Charlotte K.},
    title    = {Self-organized aerial displays of thousands of starlings: a model},
    journal  = {Behavioral Ecology},
    year     = {2010},
    volume   = {21},
    number   = {6},
    pages    = {1349--1359},
    doi      = {10.1093/beheco/arq149},
    priority = {prio2},
    annote   = {Hildenbrandt, Carere, and Hemelrijk build StarDisplay, a model of thousands of starlings flying with lift, drag, and banked turns around a cruise speed of 10 m/s, each bird interacting with about 6.5 topological neighbors through separation, alignment, and a cohesion weighted toward the flock's edge. A roost term holds flocks over a roost, a horizontal force turning a bird back once it strays outside a cylinder of 150 m radius, stronger the more it heads outward, and a vertical force pulling it toward a preferred height, which the authors call arbitrary and which flattens the flock. The model flocks match the Rome measurements in 10 of 18 statistical tests, though they come out thinner, smaller, and more level than real ones, and no predator flies in the model. Thermur takes the roost term as the component holding its flock over a band near the fire and keeping it flat, so the study shapes the composite moderately, as that one component, while the shape it serves is measured on starlings.}
}

@misc{metz2021,
    author        = {Metz, Luke and Freeman, C. Daniel and Schoenholz, Samuel S. and Kachman, Tal},
    title         = {Gradients are Not All You Need},
    year          = {2021},
    archiveprefix = {arXiv},
    eprint        = {2111.05803},
    primaryclass  = {cs.LG},
    doi           = {10.48550/arXiv.2111.05803},
    priority      = {prio2},
    annote        = {Metz and colleagues show that the gradient of a loss taken through a long unrolled run, a product of the Jacobians of every step, grows exponentially with the run's length wherever those Jacobians carry eigenvalues above one, and diverges in a chaotic system. Rigid-body physics in Brax, a learned optimizer, and a disk packing in JAX MD each show the variance of the gradient growing with the run's length even where the loss averaged over seeds is smooth, truncating the run helps only at short lengths, and no setting of the learning rate and gradient clipping trains the Ant policy in Brax, so the authors recommend black-box methods such as evolution strategies. The report is a preprint with no peer-reviewed version, and the systems it tests are not chaotic everywhere. A flight of Thermur's flock is a long noisy run of the same kind, which is why its calibration searches without gradients through differential evolution, so the study shapes how the composite's parameters are fitted rather than any component.}
}

@article{moisseeva2021,
    author   = {Moisseeva, Nadya and Stull, Roland},
    title    = {Wildfire smoke-plume rise: a simple energy balance parameterization},
    journal  = {Atmospheric Chemistry and Physics},
    year     = {2021},
    volume   = {21},
    number   = {3},
    pages    = {1407--1425},
    doi      = {10.5194/acp-21-1407-2021},
    priority = {prio3},
    annote   = {Moisseeva and Stull ran large-eddy simulations of wildfire plumes in WRF-SFIRE at 40 m horizontal spacing over a 20 by 10 km domain, varying the wind from 3 to 12 m/s, the atmosphere across nine soundings, the fuel across all 13 Anderson types, and the fireline from 1 to 4 km, and from 140 plumes that penetrate the boundary layer they derive a plume-rise height from a simple energy balance, its errors after a bias correction near 20 to 30 m. The simulations carry no latent heat and stand for daytime conditions alone. They form the WRF-SFIRE LES Synthetic Wildfire Plume Dataset, whose temperature and wind fields Thermur's flock flies through, so the study measures nothing of a flock and shapes no component of the composite, while it sets the air in which every thermal response and escape is measured.}
}

@article{mora2016,
    author   = {Mora, Thierry and Walczak, Aleksandra M. and Del Castello, Lorenzo and Ginelli, Francesco and Melillo, Stefania and Parisi, Leonardo and Viale, Massimiliano and Cavagna, Andrea and Giardina, Irene},
    title    = {Local equilibrium in bird flocks},
    journal  = {Nature Physics},
    year     = {2016},
    volume   = {12},
    number   = {12},
    pages    = {1153--1157},
    doi      = {10.1038/nphys3846},
    priority = {prio3},
    annote   = {Mora and colleagues infer the dynamics of starling flocks of 50 to 595 birds over Rome from trajectories filmed at 170 frames a second and resampled every 0.2 s, coupling each bird to its neighbors with a strength that decays with the neighbor's rank. A bird's direction relaxes almost two orders of magnitude faster than its neighbors change, so each bird sits in a local equilibrium with the neighbors it has, and the equilibrium and the dynamical inference agree on the neighbor count and on the coupling over the noise. The equilibrium holds only at the scale of the interaction, and the equilibrium inference overestimates the neighbor count where the network reshuffles about as fast as a bird relaxes, as an inference through Euler steps does at a large time step. The separation of times supports reading Thermur's flights over a network that changes slowly beside each drone's relaxation and measuring how long a statistic takes to decorrelate before a run's length is set, so the study shapes the composite little, informing how its runs are read rather than any component.}
}

@article{ohern2003,
    author   = {O'Hern, Corey S. and Silbert, Leonardo E. and Liu, Andrea J. and Nagel, Sidney R.},
    title    = {Jamming at zero temperature and zero applied stress: The epitome of disorder},
    journal  = {Physical Review E},
    year     = {2003},
    volume   = {68},
    number   = {1},
    pages    = {011306},
    doi      = {10.1103/PhysRevE.68.011306},
    priority = {prio2},
    annote   = {O'Hern, Silbert, Liu, and Nagel study frictionless soft spheres at zero temperature in two and three dimensions, with a repulsion that acts only on overlap and grows as a power of the overlap, harmonic at power two. Packings of 4 to 4,096 particles made by minimizing their energy jam at a packing fraction of 0.639, plus or minus 0.001, in three dimensions, matching random close packing, each particle touching twice as many others as the dimension at the threshold, while the pressure and the elastic moduli scale as powers of the excess packing fraction the potential sets. The study concerns static packings and no motion. Thermur's contact slot takes the harmonic soft-sphere core, whose force grows linearly with the overlap and stays bounded however far two drones overlap, so the study shapes the composite moderately, as the form of that one component.}
}

@article{papadopoulou2026,
    author   = {Papadopoulou, Marina and Hildenbrandt, Hanno and Storms, Rolf F. and Carere, Claudio and Verhulst, Simon and Hemelrijk, Charlotte K.},
    title    = {A mechanistic understanding of collective escape in starling flocks},
    journal  = {Communications Biology},
    year     = {2026},
    volume   = {9},
    number   = {1},
    pages    = {1055},
    doi      = {10.1038/s42003-026-10173-4},
    priority = {prio1},
    annote   = {Papadopoulou and colleagues filmed 19 starling flocks chased by RobotFalcon, a remote-controlled robotic falcon, and build StarEscape, a three-dimensional model of 20 to 5,000 birds each coordinating with its 7 nearest neighbors. Each bird moves among normal coordination, alarmed coordination, escape, and a refractory state through a Markov chain of its own whose probabilities depend on its alertness. A stimulus only the predator produces raises that alertness by an amount falling off exponentially with the square root of the distance to the predator, with no cutoff, and the alertness relaxes at a rate of 1 per second, while an alarmed bird may copy a neighbor's escape, a level turn of about 180 degrees or a dive. The model reproduces the collective escape patterns of the footage, the authors grant that other rules could produce the same patterns, and waves appear only in the largest flock and go unmodeled. A preprint first posted to bioRxiv in 2024 as \textit{Starling murmurations under predation} carries the earlier versions, the latest titled \textit{Towards a mechanistic understanding of collective escape in starlings}. Thermur's escape slot runs the same structure of states on its neighbor graph, its alertness built from the fire's excess over ambient air, so the study shapes that slot strongly, as the closest published model of an escape spreading through a murmuration.}
}

@article{procaccini2011,
    author   = {Procaccini, Andrea and Orlandi, Alberto and Cavagna, Andrea and Giardina, Irene and Zoratto, Francesca and Santucci, Daniela and Chiarotti, Flavia and Hemelrijk, Charlotte K. and Alleva, Enrico and Parisi, Giorgio and Carere, Claudio},
    title    = {Propagating waves in starling, \textit{Sturnus vulgaris}, flocks under predation},
    journal  = {Animal Behaviour},
    year     = {2011},
    volume   = {82},
    number   = {4},
    pages    = {759--765},
    doi      = {10.1016/j.anbehav.2011.07.006},
    priority = {prio2},
    annote   = {Procaccini and colleagues filmed falcons hunting starling flocks over two roosts in Rome, of about 20,000 and 60,000 birds, in high definition at 30 frames a second across two winters, recording more than 100 waves, which 210 of 329 hunting sequences triggered. Each wave travels away from the falcon, at 3.66 to 25.24 m/s with a mean of 13.04 m/s across 15 pulses, speeds measured against the flock's center and read as lower limits that may run 40 percent higher, and a hunt succeeded 0.14 of the time where waves arose against 0.30 where none did. The footage is two-dimensional, so the density the authors read the waves as goes unmeasured. The direction of travel, away from the threat, is the pattern Thermur's escape is checked for against a fire, so the study shapes the escape slot moderately, while the mechanism behind the band comes from Hemelrijk et al. 2015.}
}

@article{storms2019,
    author   = {Storms, Rolf F. and Carere, Claudio and Zoratto, Francesca and Hemelrijk, Charlotte K.},
    title    = {Complex patterns of collective escape in starling flocks under predation},
    journal  = {Behavioral Ecology and Sociobiology},
    year     = {2019},
    volume   = {73},
    number   = {1},
    pages    = {10},
    doi      = {10.1007/s00265-018-2609-0},
    priority = {prio1},
    annote   = {Storms and colleagues scored 795 collective events frame by frame under blinded methods in 67 of 182 sequences of falcons hunting starlings over Rome, classifying blackening (36.4 percent), waves (25.8), splits (15.8), merges (8.9), flash expansions (8.1), cordons (4.4), and vacuoles (0.6). An agitation wave lasts 3.5 s with a standard error of 0.23 and carries 2.88 pulses with a standard error of 0.19, over 133 pulses, about 0.86 s apart, and the pattern depends on the attack, flash expansion following fast attacks from above, waves most likely around attacks of medium speed, and blackening independent of the attack. A viewing angle can confuse blackening with waves, and without tracking individual birds the mechanisms stay open. The wave's duration and its pulse count are the norm Thermur's escape slot answers to, and the dependence on the attack is why the fire's approach speed is swept, so the study shapes the composite strongly, although flash expansion and the rolling behind a wave have no clear analog for a drone facing a slow plume.}
}

@article{vasarhelyi2018,
    author   = {Vásárhelyi, Gábor and Virágh, Csaba and Somorjai, Gergő and Nepusz, Tamás and Eiben, Agoston E. and Vicsek, Tamás},
    title    = {Optimized flocking of autonomous drones in confined environments},
    journal  = {Science Robotics},
    year     = {2018},
    volume   = {3},
    number   = {20},
    pages    = {eaat3536},
    doi      = {10.1126/scirobotics.aat3536},
    priority = {prio1},
    annote   = {Vásárhelyi and colleagues fly 30 autonomous quadcopters as a flock outdoors, at 4 to 8 m/s in arenas 200 to 260 m across at one altitude, under a decentralized controller whose 11 parameters an evolutionary search tuned in simulations of 100 agents carrying a 1 s delay, a 0.2 s sensor period, and an 80 m communication range. The search's fitness multiplies scores for speed, collisions closer than 3 m, disconnected agents, cluster size, wall contact, and velocity correlation. In flight the drones keep an average closest-neighbor distance of 12 to 30 m, their radios delivering 40 to 80 percent of packets from close peers and failing beyond about 50 m, a loss the simulations leave out. The authors note pressure building against the walls as the flock grows and the need to tune the parameters again for each vehicle. The study sets the bar a credible drone flock clears and the nearest-neighbor distance Thermur's calibration fits, so it shapes the composite strongly, as a measure and as the source of the radio's delay, period, and range rather than as a controller to adopt.}
}

@article{viragh2014,
    author   = {Virágh, Csaba and Vásárhelyi, Gábor and Tarcai, Norbert and Szörényi, Tamás and Somorjai, Gergő and Nepusz, Tamás and Vicsek, Tamás},
    title    = {Flocking algorithm for autonomous flying robots},
    journal  = {Bioinspiration \& Biomimetics},
    year     = {2014},
    volume   = {9},
    number   = {2},
    pages    = {025012},
    doi      = {10.1088/1748-3182/9/2/025012},
    priority = {prio2},
    annote   = {Virágh and colleagues set out a model of flying robots that adds real constraints to a flocking rule, each robot's velocity relaxing toward its command with a time constant near 1 s, its acceleration capped at 6 m/s squared, its position read through the noise of GPS, and its neighbors' states arriving every 0.2 s after a constant delay of up to 2 s within a range of 30 to 140 m. Simulations of 10 and 20 agents test the flocking rule against these constraints, and 9 quadcopters flocked outdoors at 3.5 m/s in a 120 m arena and followed a moving car. The authors treat the synchronous updates and the constant delay as artifacts of the simulation and represent outages only through the update period and the delay, leaving packet loss out of the model. Thermur's plant takes the first-order lag from command to velocity and its radio the delay, the period, and the range, so the study shapes the drone layer moderately, as the realistic agent a credible drone flock flies with.}
}
