#!/usr/bin/env -S bash -euo pipefail
#MISE alias       = "relock"
#MISE description = "Re-resolve `uv.lock`, the lockfile beside each task script declaring its own dependencies, `.mise/mise.lock`, and `docs/bun.lock` against their manifests"

source "$MISE_PROJECT_ROOT/.mise/lib/lockfiles.sh"

mise lock
each_lockfile uv lock --no-locked
bun install --cwd docs --lockfile-only
