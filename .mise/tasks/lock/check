#!/usr/bin/env -S bash -euo pipefail
#MISE alias       = "lockfile"
#MISE description = "Verify `uv.lock`, the lockfile beside each task script declaring its own dependencies, `.mise/mise.lock`, and `docs/bun.lock` against their manifests, that the lock holds every pinned tool for this platform and every platform it records, and that `mise ls-remote` lists each version `.mise/config.toml` pins"

source "$MISE_PROJECT_ROOT/.mise/lib/lockfiles.sh"

each_lockfile uv lock --check
mise lock --check >/dev/null
report=$(MISE_LOCKED_SCOPES=project mise install --dry-run --force --locked 2>&1) || {
  echo "$report" >&2
  exit 1
}
bun install --cwd docs --dry-run --frozen-lockfile >/dev/null
pins=$(mise ls --no-header --project | awk '{ print $1 "@" $2 }')
unlisted=0
for pin in $pins; do
  tool=${pin%@*}
  version=${pin##*@}
  releases=$(mise ls-remote "$tool")
  [[ -n "$releases" ]] || {
    echo "mise ls-remote lists no version of $tool, as when mise runs offline" >&2
    exit 1
  }
  grep -qxF "$version" <<< "$releases" || {
    echo "$tool pins $version, which mise ls-remote does not list" >&2
    unlisted=1
  }
done
exit "$unlisted"
