#!/usr/bin/env -S bash -euo pipefail
#MISE alias       = "links"
#MISE depends     = ["site:press"]
#MISE description = "Check every link, asset, and heading fragment in the built site, the README, and the contributor guide offline through lychee"
#MISE dir         = "{{config_root}}/docs"

dist="$PWD/.vitepress/dist"
homepage=$(node --eval "import { projectFacts } from './.vitepress/lib/manifest.ts'; console.log(projectFacts(import.meta.url).homepage)" --input-type=module)

lychee \
  --fallback-extensions html \
  --include-fragments \
  --index-files index.html \
  --no-progress \
  --offline \
  --remap "^${homepage} file://${dist}/" \
  --root-dir "$dist" \
  "$@" \
  "$dist" \
  ../README.md \
  ../.github/CONTRIBUTING.md
