#!/usr/bin/env -S bash -euo pipefail
#MISE alias       = "coverage"
#MISE description = "Run the test suite under coverage, passing any further arguments to `pytest`, then write the HTML report and the terminal report from the data every worker wrote, failing below `fail_under`"

pytest --cov --cov-fail-under=0 --cov-report= "$@" || measured=$?
coverage html --fail-under=0
coverage report
exit "${measured:-0}"
